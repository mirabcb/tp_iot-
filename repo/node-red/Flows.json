  {
    "id": "fn_alarme",
    "type": "function",
    "name": "Logique d'alarme",
    "func": "// =====================================================\n// LOGIQUE D'ALARME + COMMANDE DE LA LED\n//  Causes : principal hors ligne / capteur débranché / BPM > seuil\n//  Bouton physique (\"down\") ou bouton dashboard = ACQUITTER\n//  LED = ON si alarme, sinon état choisi par l'interrupteur du dashboard\n// =====================================================\nlet st = context.get('st') || {\n    seuil: 100, surveillance: true, online: true, data: null,\n    ackKey: '', alarme: false, ledManuel: 'off', ledEnvoyee: ''\n};\n\nswitch (msg.topic) {\n    case 'projet/principal/data':   st.data = msg.payload; break;\n    case 'projet/principal/online': st.online = (msg.payload === 'online'); break;\n    case 'seuil':                   st.seuil = Number(msg.payload); break;\n    case 'surveillance':            st.surveillance = (msg.payload === true); break;\n    case 'led':                     st.ledManuel = msg.payload; break;\n}\n\n// --- Cause de l'alarme\nlet key = '', texte = '';\nconst d = st.data;\nif (!st.online) {\n    key = 'offline'; texte = 'Nœud principal HORS LIGNE';\n} else if (d && d.capteur === false) {\n    key = 'capteur'; texte = 'Capteur cardiaque DÉBRANCHÉ';\n} else if (d && d.bpm > 0 && d.bpm > st.seuil) {\n    key = 'bpm'; texte = 'BPM trop élevé : ' + d.bpm + ' > ' + st.seuil;\n}\n\n// --- Acquittement (bouton physique appuyé ou bouton du dashboard)\nconst appui = (msg.topic === 'esp32/button1' && String(msg.payload).toLowerCase() === 'down');\nif ((appui || msg.topic === 'acquit') && key !== '') st.ackKey = key;\nif (key === '') st.ackKey = '';            // problème réglé -> réarmement\n\nconst alarme = st.surveillance && key !== '' && st.ackKey !== key;\n\n// --- LED : alarme prioritaire, sinon commande manuelle\nconst led = alarme ? 'on' : st.ledManuel;\nlet outLed = null;\nif (led !== st.ledEnvoyee) { outLed = {payload: led}; st.ledEnvoyee = led; }\n\nlet outPopup = null;\nif (alarme && !st.alarme) outPopup = {topic: '🚨 ALARME', payload: texte};\nst.alarme = alarme;\ncontext.set('st', st);\n\nlet etat;\nif (!st.surveillance)  etat = '⏸️ Surveillance désactivée';\nelse if (alarme)       etat = '🚨 ' + texte;\nelse if (key !== '')   etat = '🟠 Acquittée : ' + texte;\nelse                   etat = '✅ Normal';\n\nnode.status({fill: alarme ? 'red' : 'green', shape: 'dot', text: alarme ? texte : 'OK'});\nreturn [outLed, {payload: etat}, outPopup];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 440,
    "wires": [
      [
        "out_led"
      ],
      [
        "txt_alarme",
        "son_fn"
      ],
      [
        "toast"
      ]
    ],
    "z": "tab_cardio"
