  {
    "id": "rec_fn_btn",
    "type": "function",
    "name": "Appui long = REC ON/OFF",
    "func": "// Mesure la durée de l'appui : down -> up\nconst v = String(msg.payload).toLowerCase();\nconst now = Date.now();\nif (v === 'down') { context.set('t0', now); return null; }\nconst t0 = context.get('t0');\ncontext.set('t0', null);\nif (v !== 'up' || !t0) return null;\nif (now - t0 < 1500) return null;          // appui court = acquittement (géré par la logique d'alarme)\n\nlet rec = global.get('rec') || { actif: false, lignes: [] };\nrec.actif = !rec.actif;\nglobal.set('rec', rec);\n\nconst n = rec.lignes.length;\nconst txt = rec.actif ? '🔴 REC en cours (' + n + ' mesures)' : '⏹️ Arrêté (' + n + ' mesures)';\nreturn [ {payload: txt},\n         {topic: '💾 Enregistrement', payload: rec.actif ? 'Démarré (appui long)' : 'Arrêté : ' + n + ' mesures'} ];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 920,
