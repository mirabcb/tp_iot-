  {
    "id": "son_fn",
    "type": "function",
    "name": "Son alarme",
    "func": "// Reçoit le texte d'état de l'alarme (sortie 2 de « Logique d'alarme »)\nconst t = String(msg.payload);\nconst on = t.startsWith('🚨');\nif (on === (context.get('on') || false)) return null;   // seulement au changement\ncontext.set('on', on);\n\nlet texte = t.replace('🚨', '').trim()\n             .replace('>', 'supérieur à')\n             .replace('BPM', 'fréquence cardiaque');\nreturn { payload: on ? 'on' : 'off', texte: texte };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 1300,
    "wires": [
      [
        "son_tpl"
      ]
    ],
    "z": "tab_cardio"
  },
  {
    "id": "son_tpl",
    "type": "ui_template",
    "group": "grp_alarme",
    "name": "Sirène",
    "order": 5,
    "width": 0,
    "height": 0,
    "format": "<div style=\"text-align:center; width:100%\">\n  <md-button class=\"md-raised\" ng-click=\"activer()\"\n     ng-style=\"{'background-color': actif ? '#2e7d32' : '#c62828', 'color':'white'}\">\n     {{ actif ? '🔊 Son activé' : '🔇 Cliquer ici pour activer le son' }}\n  </md-button>\n</div>\n<script>\n(function(scope) {\n    var ctx = null, timer = null, aigu = true;\n    scope.actif = false;\n\n    // Le navigateur exige un clic avant de jouer du son\n    scope.activer = function() {\n        if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();\n        ctx.resume();\n        scope.actif = true;\n        bip();\n    };\n\n    function bip() {\n        if (!ctx) return;\n        var o = ctx.createOscillator(), g = ctx.createGain();\n        o.type = 'square';\n        o.frequency.value = aigu ? 880 : 660;   // sirène deux tons\n        aigu = !aigu;\n        g.gain.value = 0.15;\n        o.connect(g); g.connect(ctx.destination);\n        o.start(); o.stop(ctx.currentTime + 0.3);\n    }\n\n    function parler(texte) {\n        if (!('speechSynthesis' in window) || !texte) return;\n        var u = new SpeechSynthesisUtterance('Alerte. ' + texte);\n        u.lang = 'fr-FR';\n        window.speechSynthesis.speak(u);\n    }\n\n    scope.$watch('msg', function(msg) {\n        if (!msg) return;\n        if (msg.payload === 'on' && !timer) {\n            parler(msg.texte);\n            bip();\n            timer = setInterval(bip, 400);\n        }\n        if (msg.payload === 'off' && timer) {\n            clearInterval(timer); timer = null;\n            if ('speechSynthesis' in window) window.speechSynthesis.cancel();\n        }\n    });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": false,
    "templateScope": "local",
    "className": "",
    "x": 540,
    "y": 1300,
    "wires": [
      []
    ],
    "z": "tab_cardio"
  },
