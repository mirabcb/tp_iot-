    "name": "Enregistrer la mesure",
    "func": "let rec = global.get('rec') || { actif: false, lignes: [] };\nif (!rec.actif) return null;\nconst d = msg.payload;\nif (!d.capteur || d.bpm <= 0) return null;   // on n'enregistre que les vraies mesures\n\nconst now = new Date();\nrec.lignes.push({\n    date: now.toLocaleDateString('fr-FR') + ' ' + now.toLocaleTimeString('fr-FR'),\n    bpm: d.bpm, spo2: d.spo2, seuil: d.seuil, code: d.code\n});\nif (rec.lignes.length > 10000) rec.lignes.shift();\nglobal.set('rec', rec);\nreturn { payload: '🔴 REC en cours (' + rec.lignes.length + ' mesures)' };",
